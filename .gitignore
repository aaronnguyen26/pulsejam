# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing & verification modules
/coverage
test-outputs/
test-assets/
archive/
experiments/
unused/
out 2/
*.spec
scripts/verify-*.js
scripts/test-*
scripts/audio_conditioning_test.py
scripts/generate-test-audio.js
src/app/studio/dev/

# python caches & compiled bytecode
__pycache__/
*.py[cod]
*$py.class
.agents/**/__pycache__/
scripts/**/__pycache__/

# next.js
/.next/
/out/

# production
/build

# misc
